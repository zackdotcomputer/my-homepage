{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Dev: Chrome",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Dev: Server",
      "request": "launch",
      "runtimeArgs": ["run", "dev"],
      "runtimeExecutable": "pnpm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Dev: Full",
      "configurations": ["Dev: Server", "Dev: Chrome"]
    }
  ]
}
